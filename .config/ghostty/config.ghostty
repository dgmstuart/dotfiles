# Theme
theme = dark:solarized-dark,light:solarized-light

# Font
font-family = "FiraCode Nerd Font"
font-family-bold = "FiraCode Nerd Font"
font-size = 14

# character spacing, line height
adjust-cell-width = 1
adjust-cell-height = 3

# Window
window-padding-x = 5
fullscreen = non-native

# Quick terminal
keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-size = 100%,100%
quick-terminal-animation-duration = 0
